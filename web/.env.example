# Public Supabase config — safe to ship to the browser.
# This web app talks to Postgres as the LOGGED-IN user (anon key + user JWT);
# Row-Level Security enforces who can do what. There is intentionally NO
# service-role key here — privileged work lives only in Supabase edge functions.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
