# Supabase — SERVER-SIDE ONLY.
# All database access for the rating page runs on the server with the
# service-role key. Do NOT prefix either of these with NEXT_PUBLIC_ — that
# would ship the secret to the browser. There is intentionally no anon key
# here because the client never talks to Supabase directly.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
