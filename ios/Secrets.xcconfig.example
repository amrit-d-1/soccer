// Copy this file to `Secrets.xcconfig` (which is gitignored) and fill in your values.
//
// IMPORTANT xcconfig gotcha: a literal `//` starts a comment, so the `//` in an
// https URL must be broken with `$()`. That is why the URL below is written as
// `https:/$()/`. It expands to `https://` at build time. Do not "fix" it.
//
// Use the Supabase ANON (public) key here — NEVER the service-role key.
// The service-role key lives only in Vercel and the edge-function environment.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key

// Base URL of the deployed Next.js rating page (Vercel). Used by "Copy links".
// Same `$()` trick for the `//` in the scheme.
RATING_BASE_URL = https:/$()/your-rating-page.vercel.app
